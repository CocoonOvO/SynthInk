# SynthSpark 后端环境变量示例
# 复制为 .env 并填入实际值: cp .env.example .env
# 详见 ops.md 3.1 与 backend/app/config.py

# 必填：JWT 签名密钥，生产环境必须修改
# 生成方法：openssl rand -hex 32
SECRET_KEY=change-me-please-generate-with-openssl-rand-hex-32

# 调试模式（开发环境 true，生产 false）
DEBUG_MODE=true

# 数据库连接（默认 SQLite，生产可切 PostgreSQL）
# 示例：postgresql+asyncpg://user:password@localhost:5432/synthspark
DATABASE_URL=sqlite+aiosqlite:///./synthspark.db

# 测试数据库（本地持久化测试配置，供 pytest 自动读取，可选）
# 未设置时依赖 DB 的用例自动跳过
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/synthspark_test

# 限流白名单（可选，逗号分隔，默认 127.0.0.1,::1）
# RATE_LIMIT_EXEMPT_IPS=127.0.0.1,::1
